# Lokale Entwicklung: Kopie als .env anlegen (wird nicht committet).
DATABASE_URL=postgresql://BENUTZER@localhost:5432/logistik_dev
SHADOW_DATABASE_URL=postgresql://BENUTZER@localhost:5432/logistik_shadow
APP_URL=http://localhost:3000
SESSION_SECRET=                    # openssl rand -base64 48
# "development" = Anmeldung per Klick auf eine eingetragene Person (nur lokal; in Produktion verboten). "microsoft" = Entra ID.
AUTH_MODE=development
# Microsoft-Anmeldung (Single Tenant). Leer lassen = Login-Seite meldet "nicht eingerichtet".
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# nur hinter dem Reverse Proxy auf true (er muss die Client-IP in X-Forwarded-For setzen)
TRUST_PROXY=false
