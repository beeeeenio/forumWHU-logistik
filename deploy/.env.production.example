# Kopie als deploy/.env anlegen, ausfüllen, chmod 600. Niemals committen.
APP_URL=https://logistik.forumwhu.com
POSTGRES_PASSWORD=            # openssl rand -hex 24  (nur Hex: kommt in eine URL)
SESSION_SECRET=               # openssl rand -base64 48
TRUST_PROXY=true              # hinter dem Caddy des NFS-Stacks
MICROSOFT_TENANT_ID=          # Entra: Verzeichnis-(Mandanten-)ID
MICROSOFT_CLIENT_ID=          # Entra: Anwendungs-(Client-)ID der App „forumWHU Logistik“
MICROSOFT_CLIENT_SECRET=      # Entra: Wert des Client-Geheimnisses (sofort kopieren)
# Optional: Warnungen (Minusbestand, Kühlung, überfällig, Mindestbestand) an Teams/Slack melden
NOTIFY_WEBHOOK_URL=           # eingehender Webhook (https), leer = aus
CRON_SECRET=                  # openssl rand -hex 24 (für den Cron-Aufruf, siehe docs/DEPLOYMENT.md)
