{
  "name": "forumwhu-logistik",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "forumWHU Logistik – Bestand, Lagerorte, Bewegungen und Leergut für den Kongress",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "test": "node --test tests/unit/*.test.ts",
    "test:db": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://logi@127.0.0.1:5432/logistik_test} tsx --conditions=react-server --test --test-concurrency=1 tests/db/*.test.ts",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed-orte.mts",
    "verify": "npm run db:validate && npm run typecheck && npm run lint && npm test && npm run build",
    "db:demo": "tsx --conditions=react-server scripts/seed-demo.mts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/msal-node": "7.2.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.10",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
